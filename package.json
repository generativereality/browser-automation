{
  "name": "@generativereality/browser-automation",
  "version": "0.7.0",
  "description": "Let many Claude Code sessions use your own signed-in Chrome at once, each in its own tab, without stealing your screen. Daemonless CLI over per-target CDP: persistent profile and extensions, no MCP server, nothing long-lived to crash.",
  "type": "module",
  "bin": {
    "browser-automation": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    "scripts"
  ],
  "scripts": {
    "dev": "bun run ./src/index.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && bash scripts/check-one-port.sh && npm run build && npm test",
    "test": "node --test \"test/**/*.test.mjs\"",
    "release": "bash scripts/release.sh",
    "sync-plugin": "bash scripts/sync-plugin.sh",
    "prepack": "npm run build"
  },
  "keywords": [
    "claude-code",
    "browser-automation",
    "cdp",
    "chrome-devtools-protocol",
    "playwright-alternative",
    "ai-agents",
    "chrome",
    "claude-code-plugin",
    "parallel-agents",
    "cli"
  ],
  "author": "motin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generativereality/browser-automation.git"
  },
  "homepage": "https://github.com/generativereality/browser-automation",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "consola": "^3.4.0",
    "gunshi": "^0.23.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/update-notifier": "^6.0.8",
    "bumpp": "^9.11.1",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0"
  }
}
